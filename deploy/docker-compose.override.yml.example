# Copy to the repo root as docker-compose.override.yml (gitignored — it will
# hold your token) and fill in UPDATER_TOKEN. Docker Compose merges any
# docker-compose.override.yml next to docker-compose.yml automatically, so
# this is the only file you edit — docker-compose.yml itself stays untouched.
#
# deploy/install.sh does this step for you.

services:
  omnimux-api:
    volumes:
      - /run/omnimux-updater:/run/omnimux-updater:ro
    environment:
      # Must match OMNIMUX_UPDATER_TOKEN in /etc/omnimux/updater.env.
      UPDATER_TOKEN: change-me
