# Copy to /etc/omnimux/updater.env (referenced by omnimux-updater.service)
# and fill in real values. Keep this file root:root 0600 — it holds the
# shared secret that authenticates the api container to the updater daemon.

OMNIMUX_REPO_DIR=/opt/omnimux
# Matches the RuntimeDirectory= path in omnimux-updater.service.
OMNIMUX_UPDATER_SOCKET=/run/omnimux-updater/updater.sock
# Generate with: openssl rand -hex 32
# Must equal UPDATER_TOKEN in docker-compose.yml's omnimux-api environment.
OMNIMUX_UPDATER_TOKEN=change-me
