# Copy to .env (gitignored) and fill in real values. docker-compose.yml
# reads this automatically — you should never need to edit docker-compose.yml
# itself, so `git pull` never conflicts with your own secrets.

JWT_SECRET=change-me-in-production

# Opt-in auto-update (see deploy/README.md). Leave blank if you haven't run
# deploy/install.sh — it fills this in for you.
UPDATER_TOKEN=
